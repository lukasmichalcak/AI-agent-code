{
  "$defs": {
    "Asset": {
      "additionalProperties": false,
      "properties": {
        "chain": {
          "discriminator": {
            "mapping": {
              "evm": "#/$defs/EvmChain",
              "substrate": "#/$defs/SubstrateChain"
            },
            "propertyName": "ecosystem"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/EvmChain"
            },
            {
              "$ref": "#/$defs/SubstrateChain"
            }
          ],
          "title": "Chain"
        },
        "kind": {
          "enum": [
            "native",
            "erc20",
            "substrate"
          ],
          "title": "Kind",
          "type": "string"
        },
        "symbol": {
          "maxLength": 30,
          "minLength": 1,
          "title": "Symbol",
          "type": "string"
        },
        "decimals": {
          "maximum": 255,
          "minimum": 0,
          "title": "Decimals",
          "type": "integer"
        },
        "address": {
          "anyOf": [
            {
              "pattern": "^0x[0-9a-fA-F]{40}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Address"
        },
        "assetIdentifier": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Assetidentifier"
        }
      },
      "required": [
        "chain",
        "kind",
        "symbol",
        "decimals"
      ],
      "title": "Asset",
      "type": "object"
    },
    "Constraints": {
      "additionalProperties": false,
      "properties": {
        "maximumFeeUsd": {
          "anyOf": [
            {
              "maxLength": 100,
              "pattern": "^\\d+(\\.\\d+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Maximumfeeusd"
        },
        "minimumReceived": {
          "anyOf": [
            {
              "maxLength": 100,
              "pattern": "^\\d+(\\.\\d+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Minimumreceived"
        },
        "allowWrapped": {
          "default": false,
          "title": "Allowwrapped",
          "type": "boolean"
        },
        "maximumDurationSeconds": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Maximumdurationseconds"
        },
        "preference": {
          "default": "cost",
          "enum": [
            "cost",
            "speed",
            "output"
          ],
          "title": "Preference",
          "type": "string"
        }
      },
      "title": "Constraints",
      "type": "object"
    },
    "EvmChain": {
      "additionalProperties": false,
      "properties": {
        "ecosystem": {
          "const": "evm",
          "title": "Ecosystem",
          "type": "string"
        },
        "chainId": {
          "exclusiveMinimum": 0,
          "title": "Chainid",
          "type": "integer"
        }
      },
      "required": [
        "ecosystem",
        "chainId"
      ],
      "title": "EvmChain",
      "type": "object"
    },
    "SubstrateChain": {
      "additionalProperties": false,
      "properties": {
        "ecosystem": {
          "const": "substrate",
          "title": "Ecosystem",
          "type": "string"
        },
        "name": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "genesisHash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Genesishash"
        }
      },
      "required": [
        "ecosystem",
        "name"
      ],
      "title": "SubstrateChain",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "id": {
      "maxLength": 100,
      "minLength": 1,
      "title": "Id",
      "type": "string"
    },
    "naturalLanguage": {
      "default": "",
      "maxLength": 10000,
      "title": "Naturallanguage",
      "type": "string"
    },
    "sourceAsset": {
      "$ref": "#/$defs/Asset"
    },
    "destinationAsset": {
      "$ref": "#/$defs/Asset"
    },
    "amount": {
      "maxLength": 100,
      "pattern": "^\\d+(\\.\\d+)?$",
      "title": "Amount",
      "type": "string"
    },
    "recipient": {
      "maxLength": 100,
      "minLength": 1,
      "title": "Recipient",
      "type": "string"
    },
    "constraints": {
      "$ref": "#/$defs/Constraints"
    }
  },
  "required": [
    "id",
    "sourceAsset",
    "destinationAsset",
    "amount",
    "recipient"
  ],
  "title": "Intent",
  "type": "object"
}